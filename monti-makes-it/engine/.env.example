# ---------------------------------------------------------------------------
# Monti Makes It — configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Public URL of the site. Used in emails and Stripe redirect URLs.
SITE_URL=https://montimakesit.com

# --- company ---
COMPANY_NAME=Monti Makes It
SUPPORT_EMAIL=hello@montimakesit.com

# --- the centralized inboxes ---
# Every confirmed order is emailed here the moment funds clear.
ORDERS_EMAIL=orders@montimakesit.com
# Every new quote request is emailed here.
QUOTES_EMAIL=quotes@montimakesit.com
# Every membership application is emailed here.
APPLICATIONS_EMAIL=membership@montimakesit.com

# --- SLAs (hours) ---
QUOTE_SLA_HOURS=24
ORDER_REVIEW_HOURS=24

# --- membership ---
# New quote requests a member may open per cycle. Raise it per account in the admin bay
# for customers you work with often; this is only the default for new members.
QUOTE_LIMIT=10
QUOTE_CYCLE_DAYS=30
# Your standing video room, pre-filled when booking an interview. Optional.
INTERVIEW_LINK=

# --- email delivery ---
# log  = write to the database + stdout only (safe default, nothing sends)
# smtp = real delivery
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=Monti Makes It <no-reply@montimakesit.com>

# --- fees ---
# The one fee charged on every purchase, as a percentage of goods + freight + tax.
# Set to 0 to charge nothing. There is no other fee anywhere in the system.
PURCHASE_FEE_PERCENT=1.5
FEE_LABEL=Convenience fee

# What the payment network charges, passed through at cost. These are quoted to
# the customer as Stripe's fee, so they must match your actual Stripe pricing.
# Set PASS_THROUGH_PROCESSING=false to absorb it yourself instead.
STRIPE_CARD_PERCENT=2.9
STRIPE_CARD_FIXED_CENTS=30
STRIPE_ACH_PERCENT=0.8
STRIPE_ACH_CAP_CENTS=500
PASS_THROUGH_PROCESSING=true

# --- payments ---
# mock   = simulated checkout for development
# stripe = live Stripe Checkout (card + ACH bank debit)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
ENABLE_CARD=true
ENABLE_ACH=true

# --- storage ---
DATABASE_PATH=instance/monti.db
UPLOAD_DIR=monti/static/uploads
MAX_UPLOAD_MB=25

# --- session ---
# Set true once you're serving over HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_DAYS=14
